# Copy this file to .env.local and fill in real values from your own
# Supabase / Paddle / PostHog dashboards. .env.local is gitignored.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paddle dashboard -> Developer Tools
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# PostHog project settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
# In production (e.g. Vercel), set this to your deployed URL and also update
# Supabase's Authentication -> URL Configuration -> Site URL + Redirect URLs
# to match — otherwise signup confirmation emails will keep linking here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
